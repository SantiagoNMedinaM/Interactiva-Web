---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/sections/Hero.astro'
import WhyInteractiva from '../components/sections/WhyInteractiva.astro'
import Services from '../components/sections/Services.astro'
import WhenWeHelp from '../components/sections/WhenWeHelp.astro'
import Resources from '../components/sections/Resources.astro'
import Jobs from '../components/sections/Jobs.astro'
import BlogSection from '../components/sections/BlogSection.astro'
import MiCurriculumSection from '../components/sections/MiCurriculumSection.astro'
import ContactForm from '../components/sections/ContactForm.astro'
import { getLatestPosts } from '../lib/wordpress.js'
import { getLatestJobs } from '../lib/micurriculum.js'

const [posts, jobs] = await Promise.all([
  getLatestPosts(3),
  getLatestJobs(),
])
---

<Layout
  title="Interactiva — Consultoría de Capital Humano"
  description="Ayudamos a las empresas y organizaciones a tomar mejores decisiones en gestión de capital humano. Más de 20 años de experiencia regional."
>
  <Hero />
  <WhyInteractiva />
  <Services />
  <WhenWeHelp />
  <Resources />
  <Jobs jobs={jobs} />
  <BlogSection posts={posts} />
  <MiCurriculumSection />
  <ContactForm />
</Layout>
