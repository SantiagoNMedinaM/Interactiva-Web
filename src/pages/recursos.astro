---
import Layout from '../layouts/Layout.astro'
import Resources from '../components/sections/Resources.astro'
import { getResources } from '../lib/wordpress.js'

const resources = await getResources()
---

<Layout
  title="Centro de Recursos — Interactiva"
  description="Recursos prácticos y descargables para empresas y organizaciones en gestión de capital humano."
  footerVariant="inverted"
>
  <Resources
    dark
    eyebrow="Centro de Recursos"
    title="Recursos para potenciar tu gestión de personas."
    body="Guías, checklists y modelos descargables, gratis y sin compromiso, pensados para empresas y organizaciones que quieren profesionalizar la gestión de personas."
    resources={resources}
  />
</Layout>
