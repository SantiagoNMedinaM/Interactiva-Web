---
import Layout from '../layouts/Layout.astro'
import ContactForm from '../components/sections/ContactForm.astro'
---

<Layout
  title="Contacto — Interactiva"
  description="Contanos tu necesidad de capital humano. Analizamos la situación y te proponemos la solución más adecuada para tu organización."
>
  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="s-eyebrow white">Contacto</div>
      <h1 class="s-title white">Hablemos de tu<br />necesidad.</h1>
      <p class="s-body white">
        No hace falta que tengas todo claro. Contanos la situación y
        encontramos juntos la mejor solución.
      </p>
    </div>
  </div>
  <ContactForm />
</Layout>
