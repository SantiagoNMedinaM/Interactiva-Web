---
import Icon from '../Icon.astro'

interface Resource {
  title: string
  body: string
  href: string
}

interface Props {
  dark?: boolean
  eyebrow?: string
  title?: string
  body?: string
  resources?: Resource[]
}

const {
  dark = false,
  eyebrow = 'Centro de Recursos',
  title = 'Herramientas para tu gestión de personas.',
  body = 'Recursos prácticos y descargables para empresas y organizaciones. Gratis, sin compromiso.',
  resources,
} = Astro.props

const fallbackRecursos = [
  {
    icon: 'clipboard' as const,
    title: 'Modelo de descripción de perfil / puesto',
    body: 'Definí correctamente el perfil antes de iniciar una búsqueda y mejorá los resultados.',
    href: '#'
  },
  {
    icon: 'mic' as const,
    title: 'Guía para entrevistas por competencias',
    body: 'Estructura tus entrevistas y evaluá candidatos de forma más objetiva y efectiva.',
    href: '#'
  },
  {
    icon: 'check' as const,
    title: 'Checklist de incorporación de personal',
    body: 'Asegurate de cubrir todos los pasos clave en el proceso de ingreso de un colaborador.',
    href: '#'
  },
]

interface RecursoCard {
  icon: 'clipboard' | 'mic' | 'check' | 'download'
  title: string
  body: string
  href: string
}

const recursos: RecursoCard[] = resources && resources.length > 0
  ? resources.map((r: Resource) => ({ ...r, icon: 'download' as const }))
  : fallbackRecursos
---

<section class={`section-wrap ${dark ? 'bg-navy' : 'bg-light'}`} id="recursos">
  <div class="section-inner">
    <div class="two-col-header">
      <div>
        <div class={`s-eyebrow ${dark ? 'white' : ''}`}>{eyebrow}</div>
        <h2 class={`s-title ${dark ? 'white' : ''}`}>{title}</h2>
      </div>
      <p class={`s-body ${dark ? 'white' : ''}`}>{body}</p>
    </div>
    <div class="recursos-grid">
      {recursos.map(r => (
        <div class={`recurso-card ${dark ? 'dark' : ''}`}>
          <div class="recurso-icon"><Icon name={r.icon} /></div>
          <h3>{r.title}</h3>
          <p>{r.body}</p>
          <a href={r.href} class="recurso-btn" target="_blank" rel="noopener noreferrer">Descargar gratis →</a>
        </div>
      ))}
    </div>
  </div>
</section>
