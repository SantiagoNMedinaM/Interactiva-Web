---
import Icon from '../Icon.astro'

interface Resource {
  title: string
  body: string
  href: string
}

interface Props {
  dark?: boolean
  eyebrow?: string
  title?: string
  body?: string
  resources?: Resource[]
}

const {
  dark = false,
  eyebrow = 'Centro de Recursos',
  title = 'Herramientas para tu gestión de personas.',
  body = 'Recursos prácticos y descargables para empresas y organizaciones. Gratis, sin compromiso.',
  resources,
} = Astro.props

const fallbackRecursos = [
  {
    icon: 'clipboard' as const,
    title: 'Modelo de descripción de perfil / puesto',
    body: 'Definí correctamente el perfil antes de iniciar una búsqueda y mejorá los resultados.',
    href: '#'
  },
  {
    icon: 'mic' as const,
    title: 'Guía para entrevistas por competencias',
    body: 'Estructura tus entrevistas y evaluá candidatos de forma más objetiva y efectiva.',
    href: '#'
  },
  {
    icon: 'check' as const,
    title: 'Checklist de incorporación de personal',
    body: 'Asegurate de cubrir todos los pasos clave en el proceso de ingreso de un colaborador.',
    href: '#'
  },
]

interface RecursoCard {
  icon: 'clipboard' | 'mic' | 'check' | 'download'
  title: string
  body: string
  href: string
}

const recursos: RecursoCard[] = resources && resources.length > 0
  ? resources.map((r: Resource) => ({ ...r, icon: 'download' as const }))
  : fallbackRecursos
---

<section class={`section-wrap ${dark ? 'bg-navy' : 'bg-light'}`} id="recursos">
  <div class="section-inner">
    <div class="two-col-header">
      <div>
        <div class={`s-eyebrow ${dark ? 'white' : ''}`}>{eyebrow}</div>
        <h2 class={`s-title ${dark ? 'white' : ''}`}>{title}</h2>
      </div>
      <p class={`s-body ${dark ? 'white' : ''}`}>{body}</p>
    </div>
    <div class={`recursos-carousel ${dark ? 'dark' : ''}`}>
      <button type="button" class="recursos-nav-btn prev" aria-label="Ver recursos anteriores">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <div class="recursos-track">
        {recursos.map(r => (
          <div class={`recurso-card ${dark ? 'dark' : ''}`}>
            <div class="recurso-icon"><Icon name={r.icon} /></div>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
            <a href={r.href} class="recurso-btn" target="_blank" rel="noopener noreferrer">Descargar gratis →</a>
          </div>
        ))}
      </div>
      <button type="button" class="recursos-nav-btn next" aria-label="Ver más recursos">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
    <div class="recursos-dots"></div>
  </div>
</section>

<script>
  // Este componente se usa tanto en Home como en /recursos, y el layout usa
  // ClientRouter (View Transitions): Astro solo ejecuta un script inline una
  // vez por sesión de navegación SPA, así que si el carrusel ya corrió en
  // una página, no se reinicializa al navegar a otra que lo vuelve a
  // renderizar. astro:page-load corre en la carga inicial y en cada
  // navegación del router, así que garantiza que el carrusel de la página
  // actual siempre quede inicializado.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.recursos-carousel').forEach(initRecursosCarousel)
  })

  function initRecursosCarousel(carousel: HTMLElement) {
    const track = carousel.querySelector<HTMLElement>('.recursos-track')
    const prevBtn = carousel.querySelector<HTMLButtonElement>('.recursos-nav-btn.prev')
    const nextBtn = carousel.querySelector<HTMLButtonElement>('.recursos-nav-btn.next')
    const dotsWrap = carousel.parentElement?.querySelector<HTMLElement>('.recursos-dots')
    if (!track || !prevBtn || !nextBtn) return

    let pages = 1

    function buildDots() {
      if (!dotsWrap) return
      pages = Math.max(1, Math.ceil((track!.scrollWidth - 4) / track!.clientWidth))
      dotsWrap.innerHTML = ''
      if (pages <= 1) return
      for (let i = 0; i < pages; i++) {
        const dot = document.createElement('span')
        if (i === 0) dot.classList.add('active')
        dot.addEventListener('click', () => {
          const maxScroll = track!.scrollWidth - track!.clientWidth
          track!.scrollTo({ left: Math.min(i * track!.clientWidth, maxScroll), behavior: 'smooth' })
        })
        dotsWrap.appendChild(dot)
      }
    }

    function updateUI() {
      const maxScroll = track!.scrollWidth - track!.clientWidth
      const scrollable = maxScroll > 4
      carousel.classList.toggle('no-nav', !scrollable)
      prevBtn!.disabled = track!.scrollLeft <= 4
      nextBtn!.disabled = track!.scrollLeft >= maxScroll - 4
      if (dotsWrap && pages > 1) {
        const active = track!.scrollLeft <= 4
          ? 0
          : track!.scrollLeft >= maxScroll - 4
            ? pages - 1
            : Math.round(track!.scrollLeft / track!.clientWidth)
        Array.from(dotsWrap.children).forEach((dot, i) => dot.classList.toggle('active', i === active))
      }
    }

    prevBtn.addEventListener('click', () => {
      track!.scrollBy({ left: -track!.clientWidth, behavior: 'smooth' })
    })
    nextBtn.addEventListener('click', () => {
      track!.scrollBy({ left: track!.clientWidth, behavior: 'smooth' })
    })
    track.addEventListener('scroll', updateUI, { passive: true })

    let resizeTimer: ReturnType<typeof setTimeout>
    const controller = new AbortController()
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer)
      resizeTimer = setTimeout(() => {
        buildDots()
        updateUI()
      }, 150)
    }, { signal: controller.signal })
    // window persiste entre navegaciones del ClientRouter; sin esto, cada
    // vez que se reinicializa el carrusel en una página nueva quedaría un
    // listener de resize apuntando a un track ya desmontado.
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true })

    buildDots()
    updateUI()
  }

  document.querySelectorAll<HTMLElement>('.recursos-carousel').forEach(initRecursosCarousel)
</script>
