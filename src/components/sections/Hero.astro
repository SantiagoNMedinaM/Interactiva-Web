---
const WA = import.meta.env.PUBLIC_WHATSAPP
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-tag">Consultoría de Capital Humano</div>
    <h1 class="hero-title">
      Mejores decisiones<br />en <em>gestión</em> de<br />personas.
    </h1>
    <p class="hero-desc">
      Experiencia regional, enfoque práctico y flexibilidad para acompañar a empresas y
      organizaciones en cada etapa de la gestión de capital humano.
    </p>
    <div class="hero-btns">
      <a href="/contacto" class="btn-primary">Soy empresa / organización</a>
      <a href="https://www.micurriculum.com.ar" target="_blank" rel="noopener noreferrer" class="btn-ghost">
        Oportunidades laborales
      </a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="hero-stat-num">+20</div>
        <div class="hero-stat-label">años de experiencia</div>
      </div>
      <div>
        <div class="hero-stat-num">+500</div>
        <div class="hero-stat-label">búsquedas exitosas</div>
      </div>
      <div>
        <div class="hero-stat-num">Regional</div>
        <div class="hero-stat-label">raíces locales, visión amplia</div>
      </div>
    </div>
  </div>

  <div class="hero-right" aria-hidden="true">
    <div class="hero-card-stack">
      <div class="hero-card">
        <div class="hero-card-icon o">🎯</div>
        <div>
          <div class="hero-card-ttl">Atracción de talento</div>
          <div class="hero-card-txt">Encontramos el perfil que necesitás</div>
        </div>
        <div class="hero-card-badge">B2B</div>
      </div>
      <div class="hero-card">
        <div class="hero-card-icon g">🧩</div>
        <div>
          <div class="hero-card-ttl">Consultoría en RRHH</div>
          <div class="hero-card-txt">Ordenamos y mejoramos la gestión de personas</div>
        </div>
        <div class="hero-card-badge">B2B</div>
      </div>
      <div class="hero-card">
        <div class="hero-card-icon b">⚡</div>
        <div>
          <div class="hero-card-ttl">Módulos On Demand</div>
          <div class="hero-card-txt">Contratá solo lo que necesitás</div>
        </div>
        <div class="hero-card-badge">Nuevo</div>
      </div>
      <div class="hero-card accent">
        <div class="hero-card-icon o">📍</div>
        <div>
          <div class="hero-card-ttl">Raíces locales, visión regional</div>
          <div class="hero-card-txt">Conocemos el contexto empresarial de la región</div>
        </div>
      </div>
    </div>
  </div>
</section>
