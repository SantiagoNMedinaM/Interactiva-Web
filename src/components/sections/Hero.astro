---
import Icon from '../Icon.astro'
const WA = import.meta.env.PUBLIC_WHATSAPP

const heroCards = [
  {
    icon: 'target' as const,
    iconVariant: 'o',
    title: 'Atracción de talento',
    text: 'Encontramos el perfil que necesitás',
    badge: 'B2B',
  },
  {
    icon: 'sliders' as const,
    iconVariant: 'g',
    title: 'Consultoría en RRHH',
    text: 'Ordenamos y mejoramos la gestión de personas',
    badge: 'B2B',
  },
  {
    icon: 'bolt' as const,
    iconVariant: 'b',
    title: 'Módulos On Demand',
    text: 'Contratá solo lo que necesitás',
    badge: 'Nuevo',
  },
  {
    icon: 'pin' as const,
    iconVariant: 'o',
    title: 'Raíces locales, visión regional',
    text: 'Conocemos el contexto empresarial de la región',
    accent: true,
  },
]
---

<section class="hero">
  <div class="hero-left">
    <div class="hero-tag">Consultoría de Capital Humano</div>
    <h1 class="hero-title">
      Mejores decisiones<br />en <em>gestión</em> de<br />personas.
    </h1>
    <p class="hero-desc">
      Experiencia regional, enfoque práctico y flexibilidad para acompañar a empresas y
      organizaciones en cada etapa de la gestión de capital humano.
    </p>
    <div class="hero-btns">
      <a href="/contacto" class="btn-primary">Soy empresa / organización</a>
      <a href="https://www.micurriculum.com.ar" target="_blank" rel="noopener noreferrer" class="btn-ghost">
        Oportunidades laborales
      </a>
    </div>
    <div class="hero-stats">
      <div>
        <div class="hero-stat-num">+20</div>
        <div class="hero-stat-label">años de experiencia</div>
      </div>
      <div>
        <div class="hero-stat-num">+500</div>
        <div class="hero-stat-label">búsquedas exitosas</div>
      </div>
      <div>
        <div class="hero-stat-num">Regional</div>
        <div class="hero-stat-label">raíces locales, visión amplia</div>
      </div>
    </div>

    <div class="hero-cards-scroll" id="hero-cards-scroll" aria-hidden="true">
      {heroCards.map(c => (
        <div class={`hero-card ${c.accent ? 'accent' : ''}`}>
          <div class={`hero-card-icon ${c.iconVariant}`}><Icon name={c.icon} /></div>
          <div>
            <div class="hero-card-ttl">{c.title}</div>
            <div class="hero-card-txt">{c.text}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="scroll-dots" id="hero-scroll-dots" aria-hidden="true">
      {heroCards.map((_, i) => <span class={i === 0 ? 'active' : ''}></span>)}
    </div>
  </div>

  <div class="hero-right" aria-hidden="true">
    <div class="hero-card-stack">
      {heroCards.map(c => (
        <div class={`hero-card ${c.accent ? 'accent' : ''}`}>
          <div class={`hero-card-icon ${c.iconVariant}`}><Icon name={c.icon} /></div>
          <div>
            <div class="hero-card-ttl">{c.title}</div>
            <div class="hero-card-txt">{c.text}</div>
          </div>
          {c.badge && <div class="hero-card-badge">{c.badge}</div>}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const scroller = document.getElementById('hero-cards-scroll')
  const dots = document.querySelectorAll('#hero-scroll-dots span')

  scroller?.addEventListener('scroll', () => {
    const cardWidth = scroller.scrollWidth / dots.length
    const active = Math.round(scroller.scrollLeft / cardWidth)
    dots.forEach((dot, i) => dot.classList.toggle('active', i === active))
  }, { passive: true })
</script>
