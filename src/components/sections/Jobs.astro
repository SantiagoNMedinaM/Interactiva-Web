---
interface Job {
  id: number | string
  title: string
  location: string
  type: string
  badge: string
  url: string
}

interface HeaderLink {
  href: string
  label: string
}

interface Props {
  jobs: Job[]
  headerLink?: HeaderLink
}

const { jobs, headerLink } = Astro.props

function badgeClass(badge: string) {
  const map: Record<string, string> = {
    'Nuevo': 'new',
    'Urgente': 'urgent',
    'Activo': 'active',
  }
  return map[badge] ?? 'new'
}

function dotClass(badge: string) {
  const map: Record<string, string> = {
    'Urgente': 'urgent',
    'Activo': 'active',
  }
  return map[badge] ?? ''
}
---

<section class="section-wrap bg-light" id="oportunidades">
  <div class="section-inner">
    <div class="jobs-header">
      <div>
        <div class="s-eyebrow">Oportunidades laborales</div>
        <h2 class="s-title" style="font-size:32px;margin-bottom:0;">Últimas Oportunidades</h2>
      </div>
      {headerLink && (
        <a href={headerLink.href} class="jobs-link">{headerLink.label}</a>
      )}
    </div>

    <div class="jobs-grid">
      {jobs.map(job => (
        <div class="job-card">
          <div class={`job-dot ${dotClass(job.badge)}`}></div>
          <div class="job-info">
            <div class="job-title">{job.title}</div>
            <div class="job-meta">{job.location} · {job.type}</div>
          </div>
          <span class={`job-badge ${badgeClass(job.badge)}`}>{job.badge}</span>
          <a href={job.url} target="_blank" rel="noopener noreferrer" class="job-cta">
            Ver oportunidad →
          </a>
        </div>
      ))}
    </div>

    <div class="jobs-viewall">
      <a href="https://www.micurriculum.com.ar/avisos-laborales" target="_blank" rel="noopener noreferrer" class="btn-primary">
        Ver todas las oportunidades →
      </a>
    </div>

    <p class="jobs-footer-note">
      ¿Buscás trabajo? Creá tu perfil y postulate en{' '}
      <a href="https://www.micurriculum.com.ar" target="_blank" rel="noopener noreferrer">
        MiCurriculum.com.ar
      </a>
    </p>
  </div>
</section>
