---
interface Props {
  variant?: 'default' | 'inverted'
}
const { variant = 'default' } = Astro.props

const year = new Date().getFullYear()
const WA = import.meta.env.PUBLIC_WHATSAPP
const waUrl = `https://wa.me/${WA}`
const waPostulantesUrl = 'https://wa.me/5492657497391'
const logoSrc = variant === 'inverted' ? '/logos/logo-interactiva.png' : '/logos/logo-interactiva-white.png'
---

<footer class={variant === 'inverted' ? 'footer-inverted' : ''}>
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <img src={logoSrc} alt="Interactiva" class="footer-logo-img" />
        <p class="footer-desc">
          Consultoría y Gestión de Capital Humano. Más de 20 años acompañando
          empresas y organizaciones en la región.
        </p>
        <div class="footer-social">
          <a href="https://www.linkedin.com/company/interactivaconsultora/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">in</a>
          <a href="#" class="social-icon" aria-label="Facebook">fb</a>
          <a href="#" class="social-icon" aria-label="Instagram">ig</a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Servicios</h4>
        <a href="/servicios#atraccion">Atracción de talento</a>
        <a href="/servicios#ondemand">Módulos On Demand</a>
        <a href="/servicios#consultoria">Consultoría en RRHH</a>
      </div>

      <div class="footer-col">
        <h4>Empresa</h4>
        <a href="/#por-que-interactiva">Por qué Interactiva</a>
        <a href="/blog">Blog</a>
        <a href="/recursos">Centro de Recursos</a>
        <a href="/oportunidades">Oportunidades laborales</a>
      </div>

      <div class="footer-col">
        <h4>Contacto</h4>
        <span class="footer-contact-label">Empresas</span>
        <a href="mailto:comercial@interactiva.com.ar">comercial@interactiva.com.ar</a>
        <a href={waUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <a href="/contacto">Formulario de consulta</a>
        <span class="footer-contact-label">Candidatos / Postulantes</span>
        <a href="mailto:consultoria@interactiva.com.ar">consultoria@interactiva.com.ar</a>
        <a href="mailto:consultoria@interactiva.com.ar">CV@interactiva.com.ar</a>
        <a href={waPostulantesUrl} target="_blank" rel="noopener noreferrer">WhatsApp Postulantes</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Interactiva – Consultoría y Gestión de RRHH</p>
    </div>
  </div>
</footer>
