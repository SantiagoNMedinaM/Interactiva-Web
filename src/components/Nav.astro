---
const WA = import.meta.env.PUBLIC_WHATSAPP
const waUrl = `https://wa.me/${WA}`

const links = [
  { href: '/#por-que-interactiva', label: 'Por qué Interactiva' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/#cuando-ayudamos', label: '¿Cuándo podemos ayudarte?' },
  {
    label: 'Blog y Recursos',
    dropdown: [
      { href: '/blog', label: 'Blog' },
      { href: '/recursos', label: 'Centro de Recursos' },
    ],
  },
  { href: '/oportunidades', label: 'Oportunidades Laborales' },
]

const currentPath = Astro.url.pathname

function isActive(href: string) {
  return currentPath === href || currentPath.startsWith(`${href}/`)
}
---

<nav>
  <a href="/" class="nav-logo" aria-label="Interactiva — inicio">
    <img src="/logos/logo-interactiva.png" alt="Interactiva" class="nav-logo-img" />
  </a>

  <div class="nav-links" role="navigation" aria-label="Menú principal">
    {links.map(link => (
      link.dropdown ? (
        <div class={`nav-dropdown ${link.dropdown.some(d => isActive(d.href)) ? 'active' : ''}`}>
          <span class="nav-dropdown-trigger" tabindex="0">{link.label}</span>
          <div class="nav-dropdown-menu">
            <div class="nav-dropdown-menu-inner">
              {link.dropdown.map(d => (
                <a href={d.href}>{d.label}</a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
          {link.label}
        </a>
      )
    ))}
  </div>

  <a href="/contacto" class="nav-cta">Soy empresa →</a>

  <button
    class="nav-hamburger"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="nav-mobile"
    id="nav-toggle"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</nav>

<div class="nav-mobile" id="nav-mobile" role="navigation" aria-label="Menú móvil">
  {links.map(link => (
    link.dropdown ? (
      <Fragment>
        <span class="nav-mobile-label">{link.label}</span>
        {link.dropdown.map(d => (
          <a href={d.href} class="nav-mobile-sub">{d.label}</a>
        ))}
      </Fragment>
    ) : (
      <a href={link.href}>{link.label}</a>
    )
  ))}
  <a href="/contacto" class="nav-cta">Soy empresa →</a>
</div>

<script>
  // Delegado en document y con guard: las transiciones de Astro (ClientRouter)
  // pueden re-ejecutar este script sobre nodos nuevos, así que en vez de
  // atar listeners a #nav-toggle/#nav-mobile (que se reemplazan en cada
  // navegación), escuchamos en document -que persiste siempre- y buscamos
  // los elementos actuales en cada click. El guard evita que se acumulen
  // listeners duplicados en document si el script se re-ejecuta igual.
  if (!(window as any).__navDelegated) {
    ;(window as any).__navDelegated = true

    document.addEventListener('click', (e) => {
      const toggle = document.getElementById('nav-toggle')
      const menu = document.getElementById('nav-mobile')
      if (!toggle || !menu) return

      const target = e.target as Node

      if (toggle.contains(target)) {
        const isOpen = menu.classList.toggle('open')
        toggle.setAttribute('aria-expanded', String(isOpen))
        return
      }

      const clickedLink = menu.contains(target) && (target as HTMLElement).closest('a')
      if (clickedLink || !menu.contains(target)) {
        menu.classList.remove('open')
        toggle.setAttribute('aria-expanded', 'false')
      }
    })
  }
</script>
