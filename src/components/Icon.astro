---
interface Props {
  name:
    | 'target'
    | 'sliders'
    | 'bolt'
    | 'pin'
    | 'trophy'
    | 'heart'
    | 'lock'
    | 'clipboard'
    | 'mic'
    | 'check'
    | 'newspaper'
    | 'lightbulb'
    | 'rocket'
    | 'chart'
  size?: number
  class?: string
}

const { name, size = 22, class: className = '' } = Astro.props

const paths: Record<Props['name'], string> = {
