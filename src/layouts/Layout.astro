---
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import StickyMobileCta from '../components/StickyMobileCta.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  footerVariant?: 'default' | 'inverted'
}

const {
  title = 'Interactiva — Consultoría de Capital Humano',
  description = 'Más de 20 años acompañando a empresas y organizaciones en gestión de capital humano. Atracción de talento, consultoría en RRHH y módulos on demand.',
  footerVariant = 'default'
} = Astro.props

const isContacto = Astro.url.pathname === '/contacto' || Astro.url.pathname.startsWith('/contacto/')
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,600;0,9..144,700&family=DM+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class={isContacto ? '' : 'has-sticky-cta'}>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer variant={footerVariant} />
    {!isContacto && <StickyMobileCta />}

    <script>
      // ClientRouter intercepta los links con hash y actualiza la URL vía
      // history.pushState, que no dispara 'hashchange' ni el scroll nativo
      // del navegador. Para un click a un hash de la página actual tampoco
      // emite 'astro:page-load' (no hay contenido nuevo que swapear), así
      // que lo manejamos directo en el click. astro:page-load y hashchange
      // quedan como red de respaldo para el resto de los casos (carga
      // inicial, navegación cruzada de página + hash, atrás/adelante del
      // navegador).
      function scrollToHash() {
        if (!location.hash) return
        document.querySelector(location.hash)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }

      // astro:page-load dispara antes de que ClientRouter termine de resetear
      // el scroll al top en una navegación a página nueva; el timeout deja
      // que eso pase primero para que nuestro scroll no quede pisado.
      document.addEventListener('astro:page-load', () => setTimeout(scrollToHash, 50))
      window.addEventListener('hashchange', scrollToHash)

      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href*="#"]')
        if (!link) return
        const url = new URL((link as HTMLAnchorElement).href)
        if (url.pathname === location.pathname && url.hash) {
          setTimeout(() => {
            document.querySelector(url.hash)?.scrollIntoView({ behavior: 'smooth', block: 'start' })
          }, 50)
        }
      })
    </script>
  </body>
</html>
